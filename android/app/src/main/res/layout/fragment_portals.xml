<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Account &amp; Management Portals"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUserInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnPortalSeller"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/success"
        android:text="Open Seller Dashboard"
        android:textAllCaps="false"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnPortalAdmin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/warning"
        android:text="Open Admin Portal"
        android:textAllCaps="false"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnPortalSupport"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#8B5CF6"
        android:text="Customer Support Inbox"
        android:textAllCaps="false"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnPortalLogout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/danger"
        android:text="Sign Out"
        android:textAllCaps="false"
        android:textSize="15sp" />

</LinearLayout>
